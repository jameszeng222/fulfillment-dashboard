# ---------------------------------------------------------------
# 智能中枢（OPS）接入配置。密钥只放在运行环境的变量里，
# 不写进仓库、不写进页面、不打印到日志。
# 中枢平台按站点部署时会注入 OAuth 配置，其余非密钥项
# 由 deploy/run_site.py 补默认值，正常部署无需手工填写本文件。
# ---------------------------------------------------------------

# ---------- 站点自身 ----------
# 留空时由 OPS_REDIRECT_URI 推导（平台托管部署只注入后者）。
OPS_SITE_ORIGIN=https://biz.htwig.com:18700

# ---------- OAuth ----------
OPS_CLIENT_ID=YOUR_MANAGED_CLIENT_ID
OPS_CLIENT_SECRET=
OPS_REDIRECT_URI=https://biz.htwig.com:18700/ops/auth/callback
OPS_AUTHORIZE_URL=https://ops.htwig.com:10000/oauth/authorize
OPS_TOKEN_URL=https://ops.htwig.com:10000/api/oauth/token
OPS_USERINFO_URL=https://ops.htwig.com:10000/api/oauth/userinfo
# 中枢站点部署入口强制使用中枢登录。
OPS_LOCAL_LOGIN=false
# 中枢已授予站点访问权的用户首次登录时建档；OPS_SIGNUP_ROLE 决定初始角色。
OPS_ALLOW_VIEWER_SIGNUP=true
OPS_SIGNUP_ROLE=viewer
# 可使用智能助手的站内角色（逗号分隔）。
OPS_ASSISTANT_ROLES=admin,logistics,cs,viewer

# ---------- AI ----------
OPS_SITE_AI_URL=https://ops.htwig.com:10000/api/assistant/ai/v1
OPS_SITE_AI_KEY=
# chat | responses | messages，留空则按模型名或返回的 protocol 判断
OPS_AI_PROTOCOL=

# ---------- 技能 ----------
OPS_SITE_SKILLS_URL=https://ops.htwig.com:10000/api/assistant/ai/sites/11/skills

# ---------- 会话与安全 ----------
SESSION_TTL_SEC=43200
# 额度不足时的申请入口（可选，非密钥）
OPS_QUOTA_REQUEST_URL=

# ---------- 监听端口（平台托管部署会注入 PORT） ----------
PORT=18700

# 可选数据路径覆盖；默认使用项目 data/，不纳入代码发布。
OPS_DATA_DIR=
OPS_FACT_DB=
OPS_OPS_DB=
# TLS 路径由平台注入；不要自行读取、打包或上传证书私钥。
