# ---------------------------------------------------------------
# 按需启用智能中枢时使用的后端环境变量。
# 当前线上使用本机免密码入口。启用中枢前先登记实际站点和回调。
# ---------------------------------------------------------------

# ---------- 站点自身 ----------
OPS_SITE_ORIGIN=https://fulfillment-monitor.pages.dev

# ---------- OAuth ----------
OPS_CLIENT_ID=
OPS_CLIENT_SECRET=
OPS_REDIRECT_URI=https://fulfillment-monitor.pages.dev/ops/auth/callback
OPS_AUTHORIZE_URL=https://ops.htwig.com:10000/oauth/authorize
OPS_TOKEN_URL=https://ops.htwig.com:10000/api/oauth/token
OPS_USERINFO_URL=https://ops.htwig.com:10000/api/oauth/userinfo
# FastAPI 配置。中枢模式默认关闭密码登录。仅当确认平台按站点授予用户访问权时，才开启只读账号自动创建。
OPS_LOCAL_LOGIN=false
OPS_ALLOW_VIEWER_SIGNUP=false

# ---------- MCP ----------
OPS_SITE_MCP_URL=https://ops.htwig.com:10000/api/assistant/ai/sites/11/mcp
OPS_SITE_MCP_KEY=
# 逗号分隔的实际业务工具名。当前未指定工具，默认只接通发现流程。
OPS_MCP_ALLOWED_TOOLS=

# ---------- AI ----------
OPS_SITE_AI_URL=https://ops.htwig.com:10000/api/assistant/ai/v1
OPS_SITE_AI_KEY=
# chat | responses | messages，留空则按模型名自动判断
OPS_AI_PROTOCOL=

# ---------- 技能 ----------
OPS_SITE_SKILLS_URL=https://ops.htwig.com:10000/api/assistant/ai/sites/11/skills

# ---------- 会话与安全 ----------
SESSION_TTL_SEC=43200
# 额度不足时的申请入口（可选）
OPS_QUOTA_REQUEST_URL=
# FastAPI 助手使用站内角色限制，默认仅管理员可用。
OPS_ASSISTANT_ROLES=admin
